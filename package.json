{
  "name": "yrt-migrate",
  "version": "2025.1.0",
  "description": "yagisan-reportsのレイアウトXMLを最新の仕様にマイグレートするツールです。破壊的変更により廃止や非推奨になったコンポーネントを最新の仕様で置き換えます。",
  "type": "module",
  "bin": {
    "yrt-migrate": "src/index.js"
  },
  "scripts": {
    "test": "pnpm run test:unit && pnpm run test:integration && pnpm run test:regression",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:integration": "node --test test/cli.test.mjs test/integration_alpha13.test.mjs test/integration_2025_1.test.mjs",
    "test:ai:integration": "node --test --test-reporter=junit test/cli.test.mjs test/integration_alpha13.test.mjs test/integration_2025_1.test.mjs",
    "test:regression": "node --test test/regression/regression.test.mjs",
    "test:ai:regression": "node --test --test-reporter=junit test/regression/regression.test.mjs"
  },
  "author": "DenkiYagi Inc.",
  "license": "Apache-2.0",
  "dependencies": {
    "@xmldom/xmldom": "^0.8.11",
    "xml-formatter": "^3.6.7",
    "xpath": "^0.0.34"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  }
}
