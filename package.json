{
  "name": "yrt-migrate",
  "version": "2025.1.0",
  "description": "yagisan-reportsのレイアウトXMLを最新の仕様にマイグレーションするツールです。 破壊的変更により廃止や非推奨になったコンポーネントを最新の仕様で置き換えます。",
  "type": "module",
  "bin": {
    "yrt-migrate": "src/index.js"
  },
  "scripts": {
    "test": "yarn test:unit && yarn test:integration",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:integration": "node --test test/cli.test.mjs test/integration.test.mjs",
    "test:generate-fixtures": "node test/generate-fixtures.mjs"
  },
  "author": "DenkiYagi Inc.",
  "license": "Apache-2.0",
  "dependencies": {
    "@msgpack/msgpack": "^2.8.0",
    "@xmldom/xmldom": "^0.8.10",
    "xml-formatter": "^3.6.6",
    "xpath": "^0.0.33"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  }
}
